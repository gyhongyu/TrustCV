{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cv.teaforia.in/schemas/v1/audit_log.schema.json",
  "title": "TeaforiaAuditLogAndFingerprint",
  "description": "Project TrustCV / Credence: 全域時間戳存證、交付封包數位指紋與不可竄改審計日誌標準資料模型",
  "type": "object",
  "required": [
    "log_id",
    "timestamp_rfc3339",
    "event_category",
    "event_type",
    "actors",
    "cryptographic_proof",
    "state_transition",
    "compliance_assertions"
  ],
  "properties": {
    "log_id": {
      "type": "string",
      "description": "唯一審計日誌序號，格式：LOG-西元年-事件簡寫-流水號",
      "pattern": "^LOG-[0-9]{4}-[A-Z0-9_-]{4,}$",
      "examples": ["LOG-2026-SUBMIT-0088"]
    },
    "timestamp_rfc3339": {
      "type": "string",
      "format": "date-time",
      "description": "事件發生之絕對精確 UTC 時間戳（RFC 3339 / ISO 8601），為確權與防繞道法定時效基準"
    },
    "event_category": {
      "type": "string",
      "enum": [
        "JD_LIFECYCLE",
        "CANDIDATE_VERIFICATION",
        "OFFICIAL_DISPATCH",
        "INVIC_INTERACTION",
        "INTERVIEW_TRACKING",
        "SETTLEMENT_COMMISSION",
        "SECURITY_ANTI_BYPASS"
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "JD_INGESTED_RAW",
        "JD_SANITIZED_PUBLISHED",
        "CANDIDATE_DOCS_UPLOADED",
        "CANDIDATE_VERIFIED_LEVEL_2",
        "OFFICIAL_SUBMISSION_SENT",
        "INVIC_SCREENING_APPROVED",
        "INVIC_SCREENING_REJECTED",
        "INTERVIEW_LINK_ISSUED",
        "TRIPLE_GATE_UNMASK_EXECUTED",
        "OFFER_ACCEPTED_LOCKED",
        "COMMISSION_MILESTONE_PAID",
        "COLLISION_DISPUTE_TRIGGERED",
        "BYPASS_ALERT_FLAGGED"
      ]
    },
    "related_entities": {
      "type": "object",
      "properties": {
        "dossier_id": {
          "type": ["string", "null"],
          "pattern": "^TEA-[0-9]{4}-IND-[0-9]{4,}$",
          "description": "關聯候選人檔案編號"
        },
        "jd_reference_id": {
          "type": ["string", "null"],
          "pattern": "^TW-(ELE|MEC|AUT|FMW|EQP|WIR)-[0-9]{6}-[0-9]{2}$",
          "description": "關聯職缺編號"
        },
        "settlement_id": {
          "type": ["string", "null"],
          "description": "關聯佣金結算單號"
        }
      }
    },
    "actors": {
      "type": "object",
      "required": ["initiator_type", "initiator_identifier", "channel"],
      "properties": {
        "initiator_type": {
          "type": "string",
          "enum": [
            "HUMAN_TEAFORIA_AUDITOR",
            "HUMAN_INVIC_CONSULTANT",
            "HUMAN_CANDIDATE",
            "AI_AGENT_AUTOMATION",
            "SYSTEM_WEBHOOK"
          ]
        },
        "initiator_identifier": {
          "type": "string",
          "description": "操作者姓名、郵箱或 Agent 名稱（如 Dispatch_Agent, JD_Deidentification_Agent）"
        },
        "channel": {
          "type": "string",
          "enum": ["OFFICIAL_EMAIL_RFC5322", "PLATFORM_API", "WEB_CONSOLE"]
        },
        "source_ip": {
          "type": ["string", "null"],
          "description": "發起端 IP 位址（存證防偽）"
        },
        "user_agent_or_system_id": {
          "type": ["string", "null"],
          "description": "客戶端瀏覽器特徵或後端系統辨識碼"
        }
      }
    },
    "cryptographic_proof": {
      "type": "object",
      "required": [
        "payload_sha256",
        "hash_algorithm",
        "previous_log_sha256"
      ],
      "description": "不可竄改加密存證包，包含雜湊指紋與輕量雜湊鏈以防止追溯竄改歷史",
      "properties": {
        "hash_algorithm": {
          "type": "string",
          "enum": ["SHA-256", "SHA-512"],
          "default": "SHA-256"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "本事件負載資料（或附件壓縮包/PDF）之 SHA-256 數位指紋"
        },
        "previous_log_sha256": {
          "type": "string",
          "description": "前一筆日誌之 SHA-256 雜湊，構成審計雜湊鏈（Hash Chain）"
        },
        "mime_message_id": {
          "type": ["string", "null"],
          "description": "若為郵件交付，記錄 RFC 5322 Message-ID 標頭"
        },
        "email_received_header_raw": {
          "type": ["string", "null"],
          "description": "收件伺服器第一道安全網關之原始 Received 標頭存證"
        }
      }
    },
    "state_transition": {
      "type": "object",
      "required": ["previous_state", "current_state"],
      "properties": {
        "previous_state": {
          "type": "string",
          "description": "事件前狀態"
        },
        "current_state": {
          "type": "string",
          "description": "事件後狀態"
        },
        "transition_trigger_reason": {
          "type": "string",
          "description": "狀態流轉之觸發原因或業務備註"
        }
      }
    },
    "compliance_assertions": {
      "type": "object",
      "required": [
        "anti_bypass_checked",
        "deidentification_verified",
        "dual_verification_passed"
      ],
      "properties": {
        "anti_bypass_checked": {
          "type": "boolean",
          "description": "斷言：是否已符合 ARCH-002 防繞道確權標準"
        },
        "deidentification_verified": {
          "type": "boolean",
          "description": "斷言：對外或對候選人交付之內容已通過去敏脫敏審查"
        },
        "dual_verification_passed": {
          "type": "boolean",
          "description": "斷言：是否已完成原件比對與真人/Agent 初審"
        },
        "notes": {
          "type": ["string", "null"],
          "description": "合規稽核備註"
        }
      }
    }
  }
}