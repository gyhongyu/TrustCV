{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cv.teaforia.in/schemas/v1/jd_provisioning.schema.json",
  "title": "TeaforiaJobDescriptionProvisioning",
  "description": "Project TrustCV / Credence: 台灣企業職缺規格標準數據模型（含原始機密版與去識別化脫敏版）",
  "type": "object",
  "required": [
    "jd_reference_id",
    "status",
    "metadata",
    "confidential_client_profile",
    "public_sanitized_profile",
    "job_specifications",
    "compensation_and_benefits",
    "deidentification_audit"
  ],
  "properties": {
    "jd_reference_id": {
      "type": "string",
      "description": "Teaforia 系統唯一職缺編號，格式：TW-職能-西元年月份-流水號",
      "pattern": "^TW-(ELE|MEC|AUT|FMW|EQP|WIR)-[0-9]{6}-[0-9]{2}$",
      "examples": ["TW-AUT-202610-01"]
    },
    "status": {
      "type": "string",
      "enum": [
        "INGESTED_RAW",
        "DEIDENTIFIED_READY",
        "ACTIVE_SOURCING",
        "INTERVIEWING",
        "FULFILLED",
        "CANCELLED"
      ],
      "description": "職缺生命週期狀態"
    },
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "source_partner",
        "received_timestamp_utc",
        "target_hire_date"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": ["1.0.0"]
        },
        "source_partner": {
          "type": "string",
          "enum": ["INVIC_GLOBAL"],
          "description": "職缺來源合作夥伴"
        },
        "received_timestamp_utc": {
          "type": "string",
          "format": "date-time",
          "description": "invic 官方郵件寄達存證時間"
        },
        "target_hire_date": {
          "type": "string",
          "format": "date",
          "description": "預計到職目標日"
        }
      }
    },
    "confidential_client_profile": {
      "type": "object",
      "description": "【極度敏感機密】僅限 Teaforia 管理員與 invic 內部查閱，嚴格禁止對候選人露出",
      "required": [
        "company_legal_name",
        "factory_address_full",
        "hr_contact_person"
      ],
      "properties": {
        "company_legal_name": {
          "type": "string",
          "description": "台灣終端雇主法定名稱",
          "examples": ["台達電子工業股份有限公司"]
        },
        "brand_name_english": {
          "type": "string",
          "examples": ["Delta Electronics"]
        },
        "tax_id_unified": {
          "type": "string",
          "description": "台灣企業統一編號（8碼）",
          "pattern": "^[0-9]{8}$"
        },
        "stock_ticker": {
          "type": "string",
          "description": "台股上市代碼（如適用）",
          "examples": ["2308"]
        },
        "factory_address_full": {
          "type": "string",
          "description": "廠區詳細門牌地址",
          "examples": ["桃園市中壢區東園路16號"]
        },
        "hr_contact_person": {
          "type": "object",
          "required": ["name", "email"],
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "phone": {
              "type": "string"
            }
          }
        },
        "is_unmasked_to_candidate": {
          "type": "boolean",
          "default": false,
          "description": "是否已符合三門檻對特定候選人揭露"
        }
      }
    },
    "public_sanitized_profile": {
      "type": "object",
      "description": "【公開發布脫敏版】對外發布於 cv.teaforia.in 或交由審核員之資訊",
      "required": [
        "industry_tier_narrative",
        "geographic_cluster",
        "target_region_city"
      ],
      "properties": {
        "industry_tier_narrative": {
          "type": "string",
          "description": "依據 SOP-OPS-002 替換之產業地位標準畫像",
          "examples": ["台灣前三大電源供應與綠能系統上市集團"]
        },
        "geographic_cluster": {
          "type": "string",
          "description": "模糊化地理描述",
          "examples": ["北台灣高科技製造聚落（近高鐵特區）"]
        },
        "target_region_city": {
          "type": "string",
          "enum": [
            "Taipei",
            "New Taipei",
            "Taoyuan",
            "Hsinchu",
            "Miaoli",
            "Taichung",
            "Changhua",
            "Tainan",
            "Kaohsiung"
          ],
          "description": "僅開放縣市層級"
        }
      }
    },
    "job_specifications": {
      "type": "object",
      "required": [
        "role_category",
        "job_title_sanitized",
        "openings_count",
        "minimum_experience_years",
        "minimum_degree_level",
        "primary_technical_skills"
      ],
      "properties": {
        "role_category": {
          "type": "string",
          "enum": ["ELE", "MEC", "AUT", "FMW", "EQP", "WIR"],
          "description": "標準 3 碼職能類別"
        },
        "job_title_sanitized": {
          "type": "string",
          "description": "標準化脫敏職稱",
          "examples": ["資深機電自動化與 PLC 整合工程師"]
        },
        "openings_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "minimum_experience_years": {
          "type": "number",
          "minimum": 0
        },
        "minimum_degree_level": {
          "type": "string",
          "enum": ["DIPLOMA", "BACHELORS", "MASTERS", "DOCTORATE"]
        },
        "primary_technical_skills": {
          "type": "array",
          "items": { "type": "string" },
          "examples": [["PLC (Siemens/Mitsubishi)", "AutoCAD Electrical", "HMI Programming"]]
        },
        "secondary_skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "language_requirements": {
          "type": "object",
          "required": ["english_proficiency_minimum"],
          "properties": {
            "english_proficiency_minimum": {
              "type": "string",
              "enum": ["GRADE_A_FLUENT", "GRADE_B_OPERATIONAL"]
            },
            "chinese_proficiency_required": {
              "type": "boolean",
              "default": false,
              "description": "是否需基本中文能力（通常由 invic 於到職前培訓）"
            }
          }
        },
        "contract_tenure_years": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "外派合約期長度（常規為 2~3 年）"
        }
      }
    },
    "compensation_and_benefits": {
      "type": "object",
      "required": [
        "monthly_base_salary_twd_min",
        "monthly_base_salary_twd_max",
        "monthly_base_salary_inr_estimated_min",
        "monthly_base_salary_inr_estimated_max",
        "statutory_insurance_covered",
        "accommodation_support"
      ],
      "properties": {
        "monthly_base_salary_twd_min": {
          "type": "number",
          "description": "新台幣稅前月薪下限",
          "examples": [55000]
        },
        "monthly_base_salary_twd_max": {
          "type": "number",
          "description": "新台幣稅前月薪上限",
          "examples": [75000]
        },
        "monthly_base_salary_inr_estimated_min": {
          "type": "number",
          "description": "換算盧比月薪下限（以 1:2.6 基準換算）",
          "examples": [143000]
        },
        "monthly_base_salary_inr_estimated_max": {
          "type": "number",
          "description": "換算盧比月薪上限",
          "examples": [195000]
        },
        "statutory_insurance_covered": {
          "type": "boolean",
          "default": true,
          "description": "是否享有台灣勞保與全民健保"
        },
        "accommodation_support": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "COMPANY_DORMITORY_FREE",
                "COMPANY_DORMITORY_SUBSIDIZED",
                "MONTHLY_HOUSING_ALLOWANCE",
                "SELF_PAY"
              ]
            },
            "allowance_monthly_twd": {
              "type": "number",
              "default": 0
            }
          }
        },
        "airfare_support": {
          "type": "string",
          "enum": [
            "ROUND_TRIP_PROVIDED",
            "ONE_WAY_PROVIDED",
            "REIMBURSED_AFTER_PROBATION",
            "NONE"
          ]
        }
      }
    },
    "deidentification_audit": {
      "type": "object",
      "required": [
        "auditor_type",
        "auditor_identifier",
        "sanitized_timestamp_utc",
        "levenshtein_similarity_to_raw"
      ],
      "properties": {
        "auditor_type": {
          "type": "string",
          "enum": ["HUMAN_OPERATOR", "AI_AGENT"]
        },
        "auditor_identifier": {
          "type": "string",
          "description": "經手專員姓名或 Agent 名稱（如 JD_Deidentification_Agent）"
        },
        "sanitized_timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "levenshtein_similarity_to_raw": {
          "type": "number",
          "minimum": 0,
          "maximum": 0,
          "description": "斷言指標：公開版對公司法定全名之相似度必須為 0"
        }
      }
    }
  }
}